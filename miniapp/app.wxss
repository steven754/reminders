page {
  color: #172033;
  background: #f7f9fc;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
  border-radius: 16rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(33, 54, 90, .07);
}

.muted {
  color: #8893a5;
}

.primary {
  color: #ffffff;
  background: #3182f6;
}

.ghost {
  color: #526176;
  background: #eef3fa;
}
